# ===================================================================
# Smart Krishi - Example Configuration Template
# Copy this file to application.properties or configure via environment variables
# ===================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL Example)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartkrishi?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Secret Key (Use a strong random 256-bit string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRATION_MS=86400000

# Optional OpenWeatherMap API key (If blank, Smart Krishi automatically uses free Open-Meteo)
WEATHER_API_KEY=your_openweathermap_api_key_optional

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-site.netlify.app

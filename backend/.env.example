# ===================================================================
# Smart Krishi – Precision Agriculture Platform
# Backend Environment Configuration Template (Render / Server)
# ===================================================================

# Server Port
PORT=8080

# Cloud Database Connection (MySQL 8.0+)
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Signing Secret (256-bit key)
JWT_SECRET=your_production_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://smart-krishi.netlify.app,https://*.netlify.app,http://localhost:3000

# Weather API (Optional - free Open-Meteo is used by default if left blank)
WEATHER_API_KEY=

# Government Mandi Prices API (data.gov.in / AGMARKNET - register at https://data.gov.in)
MANDI_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MANDI_API_KEY=your_data_gov_in_api_key_here
MANDI_CACHE_MINUTES=15

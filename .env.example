# ===================================================================
# Smart Krishi – Precision Agriculture Platform
# Root Environment Variables Template (.env.example)
# Do NOT commit actual secrets to version control.
# ===================================================================

# -------------------------------------------------------------------
# Backend Environment Variables (Configured on Render)
# -------------------------------------------------------------------
PORT=8080

# Cloud MySQL Database (e.g., Aiven, TiDB Cloud, Railway, Supabase)
SPRING_DATASOURCE_URL=jdbc:mysql://<cloud-db-host>:<port>/<dbname>?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_secure_database_password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Authentication (32+ character secret key)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated Netlify domain, localhost, etc.)
CORS_ALLOWED_ORIGINS=https://smart-krishi.netlify.app,https://*.netlify.app,http://localhost:3000

# Weather API (Open-Meteo free API requires no key; optional key for other providers)
WEATHER_API_KEY=

# Government Mandi Prices API (data.gov.in / AGMARKNET - register at https://data.gov.in)
MANDI_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MANDI_API_KEY=your_data_gov_in_api_key_here
MANDI_CACHE_MINUTES=15

# -------------------------------------------------------------------
# Frontend Environment Variables (Configured on Netlify)
# -------------------------------------------------------------------
# Base URL pointing to the deployed Render backend
API_BASE_URL=https://smart-krishi-backend.onrender.com
